@page "/"
@using XanthosResidentialAI.Services
@inject IXanthosScoreClient ScoreClient
@inject IMetaModelClient AssistantClient
@inject IPhotoPipelineClient PhotoClient
@inject ISummaryService Summary

<PageTitle>Xanthos Residential AI — Calgary home buyer</PageTitle>

<div class="container-xl py-4" style="max-width: 1100px;">

    <header class="mb-4">
        <h1 class="h3 mb-1">Xanthos Residential AI</h1>
        <p class="text-secondary mb-0">
            One flow for a Calgary home buyer: the residential score, what it means in
            plain language, and what the listing photos actually show.
        </p>
    </header>

    @* ---------- 1. Address -> score ---------- *@
    <section class="card mb-4">
        <div class="card-header fw-semibold">1 &middot; Address &rarr; score</div>
        <div class="card-body">
            <form class="row g-2" @onsubmit="LoadScore" @onsubmit:preventDefault>
                <div class="col-md-8">
                    <input type="text" class="form-control" @bind="addressInput"
                           placeholder="e.g. 3625 Shaganappi Trail NW" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100" disabled="@scoreLoading">
                        @(scoreLoading ? "Loading…" : "Get score")
                    </button>
                </div>
            </form>

            @if (scoreError is not null)
            {
                <div class="alert alert-danger mt-3 mb-0 small">@scoreError</div>
            }
            else if (scoreResult is not null)
            {
                <div class="mt-3">
                    @if (scoreResult.IsDemoCache)
                    {
                        <div class="alert alert-warning py-2 small mb-3">
                            <strong>@scoreResult.SourceLabel</strong> — the live Xanthos
                            score connection is not wired yet (open item: endpoint
                            contract). The numbers below are placeholders, not verified
                            figures.
                        </div>
                    }
                    <h5 class="mb-3">@scoreResult.Score.Address</h5>
                    <div class="row text-center my-3">
                        <div class="col">
                            <div class="display-6">@scoreResult.Score.Overall.ToString("F1")</div>
                            <div class="text-secondary small">Overall</div>
                        </div>
                        <div class="col">
                            <div class="display-6">@scoreResult.Score.Livability.ToString("F1")</div>
                            <div class="text-secondary small">Livability</div>
                        </div>
                        <div class="col">
                            <div class="display-6">@scoreResult.Score.Investment.ToString("F1")</div>
                            <div class="text-secondary small">Investment</div>
                        </div>
                    </div>

                    <h6 class="text-secondary">Components</h6>
                    <ul class="list-group list-group-flush">
                        @foreach (var component in scoreResult.Score.Components)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@component.Name</span>
                                <span>
                                    @component.Value.ToString("F1")
                                    <span class="text-secondary small ms-1">(confidence @(component.Confidence.ToString("P0")))</span>
                                </span>
                            </li>
                        }
                    </ul>

                    <h6 class="text-secondary mt-3">Sources</h6>
                    <ul class="small mb-0">
                        @foreach (var source in scoreResult.Score.Sources)
                        {
                            <li>@source</li>
                        }
                    </ul>
                </div>
            }
            else if (scoreSearched)
            {
                <div class="alert alert-info mt-3 mb-0 small">
                    This address is not in the demo cache and the live score connection
                    is not wired yet, so there is nothing to show. No numbers are
                    invented here. (TODO: live Xanthos score endpoint contract.)
                </div>
            }
        </div>
    </section>

    @* ---------- 2. Buyer assistant ---------- *@
    <section class="card mb-4">
        <div class="card-header fw-semibold">2 &middot; Buyer assistant (Muse Spark)</div>
        <div class="card-body">
            <div class="border rounded p-3 mb-3" style="min-height: 160px; max-height: 380px; overflow-y: auto;">
                @if (messages.Count == 0)
                {
                    <p class="text-secondary small mb-0">
                        Ask about the score shown above. The assistant only uses the data
                        on this page: it says so when something is missing, and it never
                        gives price predictions.
                    </p>
                }
                @foreach (var message in messages)
                {
                    <div class="mb-2">
                        <span class="badge @(message.Role == "assistant" ? "bg-primary" : "bg-secondary")">@message.Role</span>
                        <span class="ms-1">@message.Text</span>
                        @if (message.CitedSources.Count > 0)
                        {
                            <div class="small text-secondary ms-1">sources: @string.Join(", ", message.CitedSources)</div>
                        }
                    </div>
                }
            </div>

            <form class="row g-2" @onsubmit="SendChat" @onsubmit:preventDefault>
                <div class="col-md-10">
                    <input type="text" class="form-control" @bind="chatInput"
                           placeholder="e.g. Explain the transit score in plain language" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"
                            disabled="@(chatLoading || scoreResult is null)">
                        @(chatLoading ? "…" : "Send")
                    </button>
                </div>
            </form>

            @if (!AssistantClient.IsConfigured)
            {
                <p class="small text-secondary mt-2 mb-0">
                    Assistant status: not connected yet — the Meta Model API endpoint and
                    request/response schema must be verified against the official docs
                    before any call is coded (28 Oct step). Replies are placeholders until then.
                </p>
            }
        </div>
    </section>

    @* ---------- 3. Photo analysis ---------- *@
    <section class="card mb-4">
        <div class="card-header fw-semibold">3 &middot; Listing photo analysis</div>
        <div class="card-body">
            <p class="small text-secondary">
                Photos are triaged first (blurry / duplicate / uninformative are
                discarded), then the kept ones get feature and issue flags. The
                pipeline runs in Python on this machine; SAM 3.1 segmentation lands
                on 29&ndash;30 Oct.
            </p>

            <form @onsubmit="AnalyzePhotos" @onsubmit:preventDefault>
                <label class="form-label small mb-1" for="photoUrls">Listing photo URLs (one per line)</label>
                <textarea id="photoUrls" class="form-control" rows="3" @bind="photoUrlsInput"
                          placeholder="https://…/photo1.jpg&#10;https://…/photo2.jpg"></textarea>
                <button type="submit" class="btn btn-primary mt-2" disabled="@photoLoading">
                    @(photoLoading ? "Analyzing…" : "Analyze photos")
                </button>
            </form>

            @if (photoError is not null)
            {
                <div class="alert alert-danger mt-3 mb-0 small">@photoError</div>
            }

            @if (triageSummary is not null)
            {
                <div class="alert alert-secondary mt-3 small">
                    <strong>Transparency:</strong> @triageSummary.TotalPhotos photos analyzed,
                    @triageSummary.KeptPhotos kept, @triageSummary.DiscardedPhotos discarded
                    (@(string.Join(", ", triageSummary.DiscardedByReason.Select(kv => $"{kv.Key}: {kv.Value}")))).
                </div>

                <div class="row g-3">
                    @foreach (var photo in photoResults)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 @(photo.Kept ? "" : "opacity-75")">
                                <div class="card-body small">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong>Photo @photo.PhotoIndex</strong>
                                        <span class="badge @(photo.Kept ? "bg-success" : "bg-secondary")">
                                            @(photo.Kept ? "kept" : "discarded")
                                        </span>
                                    </div>
                                    @if (!photo.Kept && photo.DiscardReason is not null)
                                    {
                                        <div class="text-secondary">reason: @photo.DiscardReason</div>
                                    }
                                    <div>
                                        room type: @(photo.RoomType ?? "n/a")@(photo.RoomConfidence is double roomConfidence ? $" ({roomConfidence.ToString("P0")})" : "")
                                    </div>
                                    <div>blur score: @(photo.BlurScore?.ToString("F1") ?? "n/a")</div>
                                    @if (photo.DetectedFeatures.Count > 0)
                                    {
                                        <div>features: @string.Join(", ", photo.DetectedFeatures)</div>
                                    }
                                    @if (photo.IssueFlags.Count > 0)
                                    {
                                        <div>issues: @string.Join(", ", photo.IssueFlags)</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    @* ---------- 4. Summary ---------- *@
    <section class="card mb-4">
        <div class="card-header fw-semibold">4 &middot; One-page summary</div>
        <div class="card-body">
            <button class="btn btn-primary" @onclick="BuildSummary"
                    disabled="@(scoreResult is null)">
                Build summary
            </button>
            <span class="small text-secondary ms-2">
                PDF export (QuestPDF) is the 31 Oct step; the text preview below is
                what the PDF will contain.
            </span>

            @if (summaryText is not null)
            {
                <pre class="mt-3 small bg-light border rounded p-3 mb-0" style="white-space: pre-wrap;">@summaryText</pre>
            }
        </div>
    </section>
</div>

@code {
    // --- 1. score ---
    private string addressInput = "";
    private bool scoreLoading;
    private bool scoreSearched;
    private string? scoreError;
    private ScoreResult? scoreResult;

    // --- 2. assistant ---
    private readonly List<AssistantMessage> messages = new();
    private string chatInput = "";
    private bool chatLoading;

    // --- 3. photos ---
    private string photoUrlsInput = "";
    private bool photoLoading;
    private string? photoError;
    private List<PhotoAnalysisResult> photoResults = new();
    private PhotoTriageSummary? triageSummary;

    // --- 4. summary ---
    private string? summaryText;

    private async Task LoadScore()
    {
        scoreLoading = true;
        scoreError = null;
        scoreSearched = false;
        try
        {
            scoreResult = await ScoreClient.GetScoreAsync(addressInput);
        }
        catch (Exception ex)
        {
            scoreError = $"Score lookup failed: {ex.Message}";
        }
        finally
        {
            scoreLoading = false;
            scoreSearched = true;
        }
    }

    private async Task SendChat()
    {
        var text = chatInput.Trim();
        if (text.Length == 0 || scoreResult is null)
        {
            return;
        }

        messages.Add(new AssistantMessage("user", text, Array.Empty<string>()));
        chatInput = "";
        chatLoading = true;
        try
        {
            var context = Summary.BuildAssistantContext(scoreResult, photoResults, triageSummary);
            var reply = await AssistantClient.ReplyAsync(messages, context);
            messages.Add(reply);
        }
        catch (Exception ex)
        {
            messages.Add(new AssistantMessage(
                "assistant", $"Assistant call failed: {ex.Message}", Array.Empty<string>()));
        }
        finally
        {
            chatLoading = false;
        }
    }

    private async Task AnalyzePhotos()
    {
        var urls = photoUrlsInput
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(u => u.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            .Take(12)
            .ToList();

        if (urls.Count == 0)
        {
            photoError = "Enter at least one http(s) photo URL.";
            return;
        }

        photoLoading = true;
        photoError = null;
        try
        {
            var batch = await PhotoClient.AnalyzeUrlsAsync(urls);
            photoResults = batch.Photos.ToList();
            triageSummary = batch.Summary;
        }
        catch (Exception ex)
        {
            photoError = $"Photo pipeline call failed (job not marked successful): {ex.Message}";
        }
        finally
        {
            photoLoading = false;
        }
    }

    private void BuildSummary()
    {
        if (scoreResult is null)
        {
            return;
        }
        summaryText = Summary.BuildTextSummary(scoreResult, messages, photoResults, triageSummary);
    }
}
